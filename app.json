{
  "expo": {
    "name": "FormTeknisi",
    "slug": "FormTeknisi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "formteknisi",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.FormTeknisi"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {}
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
